# Custom HAL - Dino Evo Torno CNC
# Painel de operacao: botoes de pulso + dois volantes (MPG)

# =============================================
#  PAINEL DE OPERACAO — todas as entradas num lugar so'
# =============================================
# Painel refeito em 2026-10-16: sairam a chave seletora de modo e a chave
# de eixo do MPG. Agora e' tudo botao momentaneo, e cada eixo tem o seu
# proprio volante.
#
#   GPIO.020  Cycle Start        (ja existia)
#   GPIO.021  Pause              (ja existia)
#   GPIO.022  Reset              (ja existia: estop clear + liga maquina)
#   GPIO.023  REFRIGERANTE       toque alterna liga/desliga
#   GPIO.024  AUTO               toque entra em AUTO
#   GPIO.025  MANUAL             toque entra em MANUAL + abre o EDITAR
#   GPIO.027  MPG liga/desliga   toque arma/desarma os dois volantes
#   GPIO.030  volante do X - A   (DB15 pino 10)
#   GPIO.031  volante do X - B   (DB15 pino 7)
#   GPIO.028  volante do Z - A   (P1 pino 8)
#   GPIO.029  volante do Z - B   (P1 pino 9)
#   GPIO.014  fim de curso (home compartilhado)
#   GPIO.015  E-Stop
#
# Botoes ligam o pino ao GND (pull-up interno), por isso tudo le por
# `.in_not`.
#
# O encoder pequeno de feed override (FYSETC EC11, GPIO.016 e GPIO.026)
# saiu do painel: quem faz feed override agora e' o volante do Z, em AUTO.
# GPIOs livres na placa hoje: 016, 026, 032 e 033.

# --- Componentes ---
# encoder: 0 = volante do X, 1 = volante do Z (os dois em software; o
# encoder de hardware do firmware e' do spindle).
loadrt encoder num_chan=2
loadrt not names=not.0,not.is-auto,not.prog-run,not.paused,not.quer-refrig
loadrt and2 names=and2.manual-livre,and2.manual-ok,and2.refrig-ok,and2.cycle-start,and2.cycle-run,and2.cycle-resume,and2.cycle-blocked,and2.estop
# Botoes de pulso que precisam LEMBRAR um estado (liga/desliga): o 'toggle'
# transforma o toque momentaneo num nivel que fica ate o proximo toque.
# AUTO e MANUAL nao usam toggle — sao comando direto, cada um no seu pino.
loadrt toggle names=toggle.mpg,toggle.refrig

addf encoder.update-counters servo-thread
addf encoder.capture-position servo-thread
addf not.0 servo-thread
addf not.is-auto servo-thread
addf not.prog-run servo-thread
addf not.paused servo-thread
addf not.quer-refrig servo-thread
addf and2.manual-livre servo-thread
addf and2.manual-ok servo-thread
addf and2.refrig-ok servo-thread
addf toggle.mpg servo-thread
addf toggle.refrig servo-thread
addf and2.cycle-start servo-thread
addf and2.cycle-run servo-thread
addf and2.cycle-resume servo-thread
addf and2.cycle-blocked servo-thread
addf and2.estop servo-thread

# --- E-Stop ---
# E-Stop fisico no GPIO.015 (P2-12) - NF (normalmente fechado)
# Normal: botao fechado -> GND -> .in=FALSE -> .in_not=TRUE -> maquina OK
# Estop:  botao aberto  -> pull-up -> .in=TRUE -> .in_not=FALSE -> desliga
# Cadeia: (estop-ext AND user-enable-out) => emc-enable-in
net estop-ext         <= hm2_7i92.0.gpio.015.in_not
net estop-ext         => and2.estop.in0
net estop-user-ok     <= iocontrol.0.user-enable-out
net estop-user-ok     => and2.estop.in1
net estop-all-ok      <= and2.estop.out
net estop-all-ok      => iocontrol.0.emc-enable-in

# =============================================
#  VOLANTES (MPG): um por eixo
# =============================================
# A chave que escolhia o eixo saiu (2026-10-16): agora sao dois volantes,
# cada um ligado direto no seu eixo. Os dois ficam armados juntos — quem
# escolhe o eixo e' a mao do operador, nao mais uma chave.
#
# x4-mode 0: 1 count por clique (detente) do volante, em vez de 4. Assim
# 1 clique = exatamente o incremento escolhido no JogIncrement
# (0.01/0.1/1 mm) -> avanco por volta ~4x menor (mais fino).
setp encoder.0.x4-mode 0
setp encoder.0.counter-mode 0
setp encoder.1.x4-mode 0
setp encoder.1.counter-mode 0

net mpgx-a encoder.0.phase-A <= hm2_7i92.0.gpio.030.in
net mpgx-b encoder.0.phase-B <= hm2_7i92.0.gpio.031.in
net mpgz-a encoder.1.phase-A <= hm2_7i92.0.gpio.028.in
net mpgz-b encoder.1.phase-B <= hm2_7i92.0.gpio.029.in

# Cada volante so' alimenta o SEU eixo (antes os dois joints recebiam as
# contagens do unico volante e a chave de eixo decidia quem andava).
net mpgx-counts encoder.0.counts => joint.0.jog-counts axis.x.jog-counts
net mpgz-counts encoder.1.counts => joint.1.jog-counts axis.z.jog-counts

# Escala (mm por click): dinamica, vinda do widget JogIncrement (aba CUSTOMS).
# Os 4 pins jog-scale sao dirigidos por qtpyvcp.jog-increment.scale no postgui
# (ver probe_basic_postgui_fix.hal). NAO usar setp aqui: conflitaria com o net.
# Default (0.01mm) e o estado inicial publicado pelo widget ao subir a GUI.

# --- Botao MPG (pulso): arma/desarma os dois volantes ---
# Era uma chave de manter; virou botao momentaneo. O 'toggle' guarda o
# estado, e como esse estado e' so' nosso (nao existe em lugar nenhum do
# LinuxCNC) ele nunca desencontra de nada.
net btn-mpg-raw  toggle.mpg.in <= hm2_7i92.0.gpio.027.in_not
setp toggle.mpg.debounce 30
net mpg-enabled  <= toggle.mpg.out

# Os dois eixos ficam habilitados juntos.
net mpg-enabled => joint.0.jog-enable axis.x.jog-enable
net mpg-enabled => joint.1.jog-enable axis.z.jog-enable

# Os sinais axis-select-x / axis-select-z sao do tempo da chave de eixo e
# ficam agora SEM ninguem escrevendo (valem FALSE). Eles so' alimentam
# halui.axis.x/z.select, que serve pro halui.axis.selected.plus/minus — e
# isso ninguem usa nesta maquina: os botoes de jog do PLC vao direto em
# halui.axis.x.plus / .minus (ver probe_basic_postgui_fix.hal). Os nets
# deles estao no Dino_Evo.hal, que carrega antes deste arquivo, por isso
# nao da' pra simplesmente apontar o mpg-enabled pros mesmos pinos.

# =============================================
#  BOTOES DE MODO: AUTO e MANUAL (um pra cada)
# =============================================
# O seletor AUTO/MDI/JOG saiu do painel (2026-10-16). No lugar ficaram dois
# botoes momentaneos, um pra cada modo. Como sao dois, nao precisa de
# 'toggle' nenhum: cada botao e' um comando direto, e o halui atende esses
# pinos na BORDA de subida (conferido no sim) — o toque E' o comando.
#
#   GPIO.024 -> GND = AUTO
#   GPIO.025 -> GND = MANUAL
#
# Nao ha mais botao fisico de MDI. O MDI continua na tela: digitar na caixa
# MDI ja troca o modo sozinho.

# --- AUTO: direto, sem travas ---
# Nao precisa de trava: pedir AUTO com um programa rodando ja' e' o modo
# vigente, entao o halui nao faz nada.
net btn-auto  halui.mode.auto  <= hm2_7i92.0.gpio.024.in_not

# --- MANUAL: ignorado com programa rodando ou pausado ---
# Decisao do operador (2026-10-16): um esbarrao no botao nao pode derrubar
# o ciclo. Para parar: PAUSA no painel ou PARAR na tela.
#
# A trava e' na ENTRADA, antes de virar comando — assim nao sobra pedido
# represado pra disparar sozinho quando o programa acabar.
#
# O interlock antigo — que parava o programa quando a chave saia do AUTO —
# foi embora junto com a chave: sem chave nao existe "posicao fora do
# AUTO" pra detectar. O Cycle Start fisico continua so' valendo em AUTO,
# agora olhando halui.mode.is-auto (o modo de verdade).
net btn-manual-raw   <= hm2_7i92.0.gpio.025.in_not
net btn-manual-raw   => and2.manual-livre.in0
net prog-running     halui.program.is-running => not.prog-run.in
net not-running      not.prog-run.out         => and2.manual-livre.in1
net manual-livre     and2.manual-livre.out    => and2.manual-ok.in0
net prog-paused      => not.paused.in
net not-paused       not.paused.out           => and2.manual-ok.in1
net btn-manual       halui.mode.manual        <= and2.manual-ok.out

# O mesmo toque abre o modo EDITAR na tela (pedido do operador: "manual
# ativa o modo editar sempre junto"). Quem faz isso e' o customs.py, que
# le este pino e clica na aba EDITAR — por isso o sinal vai tambem pro
# componente dino_painel (ver probe_basic_postgui_fix.hal).

# =============================================
#  BOTAO DO REFRIGERANTE (pulso)
# =============================================
# A entrada que era o MDI do seletor virou o liga/desliga do refrigerante.
#
#   GPIO.023 -> GND = toque no botao de REFRIGERANTE
#
# Mesma ideia do modo: o toque vira um nivel, o nivel manda o halui ligar
# ou desligar. E' a MESMA bomba que o M8/M9 do programa liga —
# coolant-flood vai pro ams32.cmd.00 (PLC) no postgui.
#
# O M8/M9 do programa NAO e' atrapalhado: halui.flood.off fica em TRUE
# enquanto o botao esta' desligado, mas o halui so' olha a borda. Medido no
# sim: com flood.off preso em TRUE, um flood.on depois liga a bomba do
# mesmo jeito.
#
# So' aceita toque com a maquina LIGADA: aperto com a maquina desligada nao
# faria nada na bomba e so' deixaria o nivel desencontrado.
net btn-refrig-raw   <= hm2_7i92.0.gpio.023.in_not
net btn-refrig-raw   => and2.refrig-ok.in0
net machine-is-on    => and2.refrig-ok.in1
net btn-refrig       toggle.refrig.in         <= and2.refrig-ok.out
setp toggle.refrig.debounce 30

net quer-refrig      toggle.refrig.out        => halui.flood.on
net quer-refrig      => not.quer-refrig.in
net nao-quer-refrig  not.quer-refrig.out      => halui.flood.off

# =============================================
#  BOTOES FISICOS: CYCLE START, PAUSE/RESUME, RESET
# =============================================
# 3 botoes momentaneos, ligam pino ao GND (pull-up interno)
#   GPIO.020 = Cycle Start
#   GPIO.021 = Pause/Resume (toggle)
#   GPIO.022 = Reset (estop clear + machine on)

# --- Sinais de estado do programa ---
net prog-paused  halui.program.is-paused => and2.cycle-resume.in1
net prog-idle    halui.program.is-idle   => and2.cycle-run.in1

# --- Cycle Start: GPIO.020 -> AND com o modo AUTO de verdade ---
net btn-cycle-start-raw  and2.cycle-start.in0  <= hm2_7i92.0.gpio.020.in_not
net mode-is-auto         => and2.cycle-start.in1
net btn-cycle-start      <= and2.cycle-start.out

# --- Run: btn-cycle-start AND is-idle -> program.run ---
# is-idle garante que run so dispara quando programa parado (nao durante startup)
net btn-cycle-start      => and2.cycle-run.in0
net do-run               halui.program.run    <= and2.cycle-run.out

# --- Resume: btn-cycle-start AND is-paused -> program.resume ---
net btn-cycle-start      => and2.cycle-resume.in0
net do-resume            halui.program.resume <= and2.cycle-resume.out

# --- Blocked: btn-cycle-start-raw AND NOT-auto -> aviso na tela ---
# Sinal conectado ao widget no postgui
net btn-cycle-start-raw  => and2.cycle-blocked.in0
net mode-is-auto         => not.is-auto.in
net not-auto             not.is-auto.out => and2.cycle-blocked.in1
net cycle-blocked        <= and2.cycle-blocked.out

# --- Pause: GPIO.021 -> halui.program.pause ---
# Botao so pausa. Para continuar, apertar Cycle Start (GPIO.020)
net btn-pause  halui.program.pause  <= hm2_7i92.0.gpio.021.in_not

# --- Reset: GPIO.022 -> estop reset + machine on ---
net btn-reset halui.estop.reset   <= hm2_7i92.0.gpio.022.in_not
net btn-reset halui.machine.on

# =============================================
#  FEED OVERRIDE pelo volante do Z em modo AUTO
# =============================================
# O encoder pequeno que fazia isso (FYSETC EC11, GPIO.016/026) saiu do
# painel em 2026-10-16. Agora cada volante tem funcao dupla em AUTO:
#
#   volante do X -> rapid override
#   volante do Z -> feed override
#
# Fora do AUTO os dois voltam a ser so' jog, porque o count-enable fica
# FALSE e o halui ignora as contagens. Escala 0.01 = 1% por click.
net mpgz-counts      => halui.feed-override.counts
setp halui.feed-override.scale 0.01
net mode-is-auto     => halui.feed-override.count-enable

# =============================================
#  RAPID OVERRIDE pelo volante do X em modo AUTO
# =============================================
# Em AUTO: girar o volante do X ajusta o rapid override (o botao MPG nao
# entra nisso). Fora do AUTO o volante faz jog normal, porque o
# count-enable fica FALSE e o halui ignora as contagens.
# Escala 0.01 = 1% por click.

net mpgx-counts      => halui.rapid-override.counts
setp halui.rapid-override.scale 0.01
net mode-is-auto     halui.mode.is-auto => halui.rapid-override.count-enable

# =============================================
#  FIM DE CURSO - Chave compartilhada X e Z
# =============================================
# GPIO.014 = Fim de curso NF (serie) - usado apenas como HOME
# Limites de curso protegidos por software (MIN_LIMIT/MAX_LIMIT no INI)
# Normal: chaves fechadas -> GND -> .in=FALSE = OK
# Home: chave abre -> pull-up -> .in=TRUE = posicao home
net home-shared <= hm2_7i92.0.gpio.014.in
net home-shared => joint.0.home-sw-in
net home-shared => joint.1.home-sw-in

# Alarme servos: ver probe_basic_postgui_fix.hal (ams32 so carrega no postgui)
