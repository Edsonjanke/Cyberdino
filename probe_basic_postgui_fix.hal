# Postgui mínimo para evitar conflito de tool-change-confirmed no Probe Basic
# Tool-change continua via hal_manualtoolchange (carregado no HAL principal)

loadrt time

addf time.0 servo-thread
# not.0 ja carregado e adicionado no custom.hal

# *** Timer - obrigatório para Probe Basic ***
# prog-idle ja criado no custom.hal (halui.program.is-idle)
net prog-idle => not.0.in
# prog-paused ja criado no custom.hal (halui.program.is-paused)
# aqui so adiciona o reader do timer
net prog-paused => time.0.pause
net cycle-timer time.0.start <= not.0.out
net cycle-seconds qtpyvcp.timerseconds.in <= time.0.seconds
net cycle-minutes qtpyvcp.timerminutes.in <= time.0.minutes
net cycle-hours qtpyvcp.timerhours.in <= time.0.hours

# *** Spindle RPM display - encoder hardware filtrado ***
net spindle-fb-rpm-abs-filtered => qtpyvcp.spindle-encoder-rpm.in

# --- Indicador MPG na interface ---
# MpgButton customizado: pin .in controla checked, mouse bloqueado
net mpg-enabled => qtpyvcp.mpg-indicator.in

# --- Aviso botao fisico: cycle-start fora de AUTO mostra mensagem na tela ---
net cycle-blocked => qtpyvcp.cycle-start-button.blocked

# --- Botoes Spindle na aba CUSTOMS (HalButton pulseOnPress 200ms) ---
# PARA SPINDLE: drive halui.spindle.0.stop (via spindle-manual-stop, Dino_Evo.hal:355)
#               + dispara save no dino_spindle (snapshot RPM atual)
# LIGA M3/M4:   roteia pro dino_spindle.restore-cw/ccw que envia cmd.spindle(dir, rpm)
#               direto via Python na ultima RPM salva. NAO usa halui.spindle.0.forward
#               (que usaria S literal como RPM, errado em G96/CSS).
net spindle-manual-stop <= qtpyvcp.spindle-off.out
net spindle-manual-stop => dino_spindle.save
net spindle-restore-cw  <= qtpyvcp.spindle-on-cw.out  => dino_spindle.restore-cw
net spindle-restore-ccw <= qtpyvcp.spindle-on-ccw.out => dino_spindle.restore-ccw

# Wire RPM atual (calculada pelo interp ja considerando G96/CSS) pro componente.
# Sinal spindle-vel-cmd-rpm ja sourceia spindle.0.speed-out em Dino_Evo.hal:179.
net spindle-vel-cmd-rpm => dino_spindle.speed-in

# D do G96 (max RPM CSS): o<g96> faz M68 E5 Q<D> -> motion.analog-out-05.
# customs.py le esse pin pra atualizar o label MAX RPM em tempo real.
net dino-css-d <= motion.analog-out-05 => dino_spindle.css-d

# --- Caixa de marchas: GearSelector da UI (6 marchas) controla gear-sel{0..2} ---
# qtpyvcp.gear-selector.sel{0,1,2} (out): indice da marcha em binario (0..5)
# qtpyvcp.gear-selector.spinning   (in): desabilita widget quando spindle gira
# Reusa sinal spindle-enable (ja existe como source spindle.0.on em Dino_Evo.hal)
net gear-sel0 <= qtpyvcp.gear-selector.sel0
net gear-sel1 <= qtpyvcp.gear-selector.sel1
net gear-sel2 <= qtpyvcp.gear-selector.sel2
net spindle-enable => qtpyvcp.gear-selector.spinning

# GearLabel no DRO: mostra a marcha atual (M0X - RPM). Le os mesmos 3 bits
# que o GearSelector publica (so adiciona consumidores aos sinais existentes).
net gear-sel0 => qtpyvcp.gear-current-dro.sel0
net gear-sel1 => qtpyvcp.gear-current-dro.sel1
net gear-sel2 => qtpyvcp.gear-current-dro.sel2

# --- Incremento do MPG: JogIncrement da UI (0.01/0.1/1 mm) controla jog-scale ---
# qtpyvcp.jog-increment.scale (float out): mm por count do volante.
# Substitui os antigos setp jog-scale (removidos de custom.hal).
net jog-increment-scale <= qtpyvcp.jog-increment.scale
net jog-increment-scale => joint.0.jog-scale
net jog-increment-scale => joint.1.jog-scale
net jog-increment-scale => axis.x.jog-scale
net jog-increment-scale => axis.z.jog-scale

# ############################################################################
# AMS32 - PLC Modbus ASCII via Python (coolant)
# ############################################################################
loadusr -Wn ams32 python3 ams32_hal.py

# ############################################################################
# Contador de pecas - incrementa em M30/M2, persiste em parts_count.txt
# ############################################################################
loadusr -Wn partcounter python3 partcounter.py
# Display do contador: aba CUSTOMS, DRO da lateral e DRO grande da tela principal
net parts-count <= partcounter.count => qtpyvcp.parts-count.in => qtpyvcp.parts-count-dro.in => qtpyvcp.parts-count-big.in
# Reset do contador via botao na aba CUSTOMS (HalButton parts_reset, pulse 200ms)
net parts-count-reset <= qtpyvcp.parts-reset.out => partcounter.reset
# Preset digitado + botao SET (HalQSpinBox parts_preset, HalButton parts_load)
net parts-preset-val  <= qtpyvcp.parts-preset.out => partcounter.preset
net parts-preset-load <= qtpyvcp.parts-load.out   => partcounter.load
# partcounter.trigger fica solto: M101 pulsa via halcmd setp

# ---angulo da placa (0-360 graus, relativo ao startup)---
# chuck_angle.py le spindle-revs (revolucoes do encoder.01) e calcula
# (revs % 1.0)*360. Mostrado no DRO custom (HalLabel chuck_angle_dro).
loadusr -Wn chuckangle python3 chuck_angle.py
net spindle-revs  => chuckangle.revs
net chuck-angle   <= chuckangle.angle => qtpyvcp.chuck-angle.in

# Coolant M8/M9 -> PLC M100 -> Y0 (bomba)
net coolant-flood    => ams32.cmd.00

# Posicao dos eixos -> PLC D2000-D2003 (salvar posicao para restore)
net x-pos-fb         => ams32.pos-cmd-x
net z-pos-fb         => ams32.pos-cmd-z

# Jog via botoes PLC: M200-M203 -> sinais jog-x/z-pos/neg (ja netados em Dino_Evo.hal)
# Velocidade = G0 (rapid): 4500 mm/min = 75 mm/s (X MAX_VELOCITY; Z clampa em 72 mm/s = 4320 mm/min)
# ATENCAO: halui.axis.jog-speed em LinuxCNC 2.9 e em MACHINE UNITS PER MINUTE (nao por segundo)
# Modo teleop usa halui.axis.*, nao halui.joint.*
sets jog-speed 4500

net jog-x-pos  <=  ams32.status.00
net jog-x-neg  <=  ams32.status.01
# Z invertido: botao "Z+" (M202) gera jog-z-neg; "Z-" (M203) gera jog-z-pos
net jog-z-pos  <=  ams32.status.03
net jog-z-neg  <=  ams32.status.02

# Alarme servos X/Z (HLTNC T3D) -> M207 (ladder bloco 7) -> E-stop
# Ladder AMS32 agrega X7 OR /X10 OR /X11 em M207 (= ams32.status.07).
# Reset: pressionar reset fisico (GPIO.022) apos servos ficarem OK.
net servo-fault <= ams32.status.07
net servo-fault => halui.estop.activate
