o<touch_off_x> sub

M70
#<settings_lineedit> = #1 (=0.0000)
#5 = #<_abs_x>
#6 = #<_lathe_diameter_mode>
#<current_tool_number> = #5400
#<machine_position_radius> = #<_abs_x>
o100 if [#<_lathe_diameter_mode> EQ 0]
  #<workpiece_radius> = #<settings_lineedit>
o100 else
  #<workpiece_radius> = [#<settings_lineedit> / 2]
o100 endif
#<current_g54_x> = #5221
#<new_tool_offset> = [#<machine_position_radius> - #<workpiece_radius> - #<current_g54_x>]
G8
G10 L1 P #5400 X [#<new_tool_offset>]
M61 Q0
G49
G10 L0
M72
M61 Q#<current_tool_number> G43

o<touch_off_x> endsub

M2
