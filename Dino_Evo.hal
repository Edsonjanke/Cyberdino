setp   hm2_7i92.0.stepgen.01.step_type        0
setp   hm2_7i92.0.stepgen.01.control-type     1
setp   hm2_7i92.0.stepgen.01.maxaccel         [JOINT_1]STEPGEN_MAXACCEL
setp   hm2_7i92.0.stepgen.01.maxvel           [JOINT_1]STEPGEN_MAXVEL

# ---closedloop stepper signals---

net z-pos-cmd    <= joint.1.motor-pos-cmd
net z-vel-cmd    <= joint.1.vel-cmd
net z-output     => hm2_7i92.0.stepgen.01.velocity-cmd
net z-pos-fb     <= hm2_7i92.0.stepgen.01.position-fb
net z-pos-fb     => joint.1.motor-pos-fb
net z-enable     <= joint.1.amp-enable-out
net z-enable     => hm2_7i92.0.stepgen.01.enable

# ---setup home / limit switch signals---

# Configurado no custom.hal (GPIO.014 compartilhado X+Z)

#*******************
#  SPINDLE
#*******************

setp   pid.s.Pgain     [SPINDLE_0]P
setp   pid.s.Igain     [SPINDLE_0]I
setp   pid.s.Dgain     [SPINDLE_0]D
setp   pid.s.bias      [SPINDLE_0]BIAS
setp   pid.s.FF0       [SPINDLE_0]FF0
setp   pid.s.FF1       [SPINDLE_0]FF1
setp   pid.s.FF2       [SPINDLE_0]FF2
setp   pid.s.deadband  [SPINDLE_0]DEADBAND
setp   pid.s.maxoutput [SPINDLE_0]MAX_OUTPUT
setp   pid.s.error-previous-target true

net spindle-index-enable  =>  pid.s.index-enable
net spindle-enable        =>  pid.s.enable
# spindle-vel-cmd-rpm vai para pid.s.command via gearbox (clamp por marcha) - ver secao CAIXA DE MARCHAS
net spindle-vel-fb-rpm      => pid.s.feedback
net spindle-output        <=  pid.s.output

# ---setup spindle control signals---

net spindle-vel-cmd-rps        <=  spindle.0.speed-out-rps
net spindle-vel-cmd-rps-abs    <=  spindle.0.speed-out-rps-abs
net spindle-vel-cmd-rpm        <=  spindle.0.speed-out
net spindle-vel-cmd-rpm-abs    <=  spindle.0.speed-out-abs
net spindle-enable             <=  spindle.0.on
net spindle-cw                 <=  spindle.0.forward
net spindle-ccw                <=  spindle.0.reverse
net spindle-brake              <=  spindle.0.brake
net spindle-at-speed           =>  spindle.0.at-speed

# --- Encoder hardware 7i92 (portado do Dino) ---
setp    hm2_7i92.0.encoder.01.counter-mode 0
setp    hm2_7i92.0.encoder.01.filter 1
setp    hm2_7i92.0.encoder.01.index-invert 0
setp    hm2_7i92.0.encoder.01.index-mask 0
setp    hm2_7i92.0.encoder.01.index-mask-invert 0
setp    hm2_7i92.0.encoder.01.scale  [SPINDLE_0]ENCODER_SCALE

net spindle-revs         <= hm2_7i92.0.encoder.01.position
net spindle-index-enable <=> hm2_7i92.0.encoder.01.index-enable

# Filtro lowpass no feedback pra suavizar leitura jitter
setp lowpass.spindle-rps.gain 0.02
net spindle-vel-fb-rps-raw   <= hm2_7i92.0.encoder.01.velocity
net spindle-vel-fb-rps-raw   => lowpass.spindle-rps.in
net spindle-vel-fb-rps       <= lowpass.spindle-rps.out
net spindle-vel-fb-rpm       <= hm2_7i92.0.encoder.01.velocity-rpm

net spindle-revs         => spindle.0.revs
net spindle-vel-fb-rps   => spindle.0.speed-in
net spindle-index-enable <=> spindle.0.index-enable

net spindle-vel-fb-rpm   => motion.analog-in-00

# filtro de velocidade (abs + lowpass) para display suavizado
# lowpass.spindle.gain 0.05 = ~20ms TC extra so no display (nao afeta at-speed nem PID)
setp  scale.spindle.gain 60
setp  lowpass.spindle.gain 0.05
net spindle-vel-fb-rps          =>  scale.spindle.in
net spindle-fb-rpm               scale.spindle.out     => abs.spindle.in
net spindle-fb-rpm-abs           abs.spindle.out       => lowpass.spindle.in
net spindle-fb-rpm-abs-filtered  lowpass.spindle.out

# ---Setup spindle at speed signals---
# near: at-speed = TRUE quando |cmd - fb| <= max(difference, scale * |cmd|)
# inputs em RPS (1 RPS = 60 RPM). scale 0.05 = 5% relativo; difference 0.5 RPS = 30 RPM piso.
# Eixos so avancam apos spindle.0.at-speed = TRUE (travamento automatico do motion).
setp near.spindle.scale      0.30
setp near.spindle.difference 2.0
net spindle-vel-cmd-rps-abs => near.spindle.in1
# Feedback passa por abs antes do near para funcionar em M3 (positivo) e M4 (negativo).
# near.spindle.in1 e ABSOLUTO (cmd-rps-abs); precisamos do feedback tambem absoluto.
net spindle-vel-fb-rps      => abs.spindle-rps.in
net spindle-vel-fb-rps-abs  <= abs.spindle-rps.out  => near.spindle.in2
net spindle-at-speed        <= near.spindle.out

#*******************************************
# CAIXA DE MARCHAS - 16 marchas manuais (troca com maquina parada)
#   idx  Marcha   RPM    ratio (motor/chuck = 2360/RPM)
#    0   M01     2360    1.0000
#    1   M02     1500    1.5733
#    2   M03      950    2.4842
#    3   M04      750    3.1467
#    4   M05      600    3.9333
#    5   M06      475    4.9684
#    6   M07      375    6.2933
#    7   M08      300    7.8667
#    8   M09      236   10.0000
#    9   M10      150   15.7333
#   10   M11      118   20.0000
#   11   M12       95   24.8421
#   12   M13       90   26.2222
#   13   M14       75   31.4667
#   14   M15       60   39.3333
#   15   M16       30   78.6667
# Selecao via 4 bits (sel0/sel1/sel2/sel3) vindos do widget GearSelector na UI:
#   - mux16.spindle-cmd  : seleciona limit2.gNN (clampa cmd_chuck por marcha)
#   - mux16.gear-factor  : seleciona ratio aplicado ao motor (mult2 antes do scale.spindle-pwm)
# Encoder fica na placa (chuck), entao at-speed/PID/threading operam em RPM real do chuck.
#*******************************************
setp limit2.g01.max  2360
setp limit2.g01.min -2360
setp limit2.g02.max  1500
setp limit2.g02.min -1500
setp limit2.g03.max   950
setp limit2.g03.min  -950
setp limit2.g04.max   750
setp limit2.g04.min  -750
setp limit2.g05.max   600
setp limit2.g05.min  -600
setp limit2.g06.max   475
setp limit2.g06.min  -475
setp limit2.g07.max   375
setp limit2.g07.min  -375
setp limit2.g08.max   300
setp limit2.g08.min  -300
setp limit2.g09.max   236
setp limit2.g09.min  -236
setp limit2.g10.max   150
setp limit2.g10.min  -150
setp limit2.g11.max   118
setp limit2.g11.min  -118
setp limit2.g12.max    95
setp limit2.g12.min   -95
setp limit2.g13.max    90
setp limit2.g13.min   -90
setp limit2.g14.max    75
setp limit2.g14.min   -75
setp limit2.g15.max    60
setp limit2.g15.min   -60
setp limit2.g16.max    30
setp limit2.g16.min   -30
# maxv = max rate de mudanca (RPM/s). Alto para nao limitar (queremos clamp puro de valor)
setp limit2.g01.maxv 1e9
setp limit2.g02.maxv 1e9
setp limit2.g03.maxv 1e9
setp limit2.g04.maxv 1e9
setp limit2.g05.maxv 1e9
setp limit2.g06.maxv 1e9
setp limit2.g07.maxv 1e9
setp limit2.g08.maxv 1e9
setp limit2.g09.maxv 1e9
setp limit2.g10.maxv 1e9
setp limit2.g11.maxv 1e9
setp limit2.g12.maxv 1e9
setp limit2.g13.maxv 1e9
setp limit2.g14.maxv 1e9
setp limit2.g15.maxv 1e9
setp limit2.g16.maxv 1e9

setp mux16.gear-factor.in00  1.0000     # M01: 2360 RPM
setp mux16.gear-factor.in01  1.5733     # M02: 1500 RPM
setp mux16.gear-factor.in02  2.4842     # M03:  950 RPM
setp mux16.gear-factor.in03  3.1467     # M04:  750 RPM
setp mux16.gear-factor.in04  3.9333     # M05:  600 RPM
setp mux16.gear-factor.in05  4.9684     # M06:  475 RPM
setp mux16.gear-factor.in06  6.2933     # M07:  375 RPM
setp mux16.gear-factor.in07  7.8667     # M08:  300 RPM
setp mux16.gear-factor.in08 10.0000     # M09:  236 RPM
setp mux16.gear-factor.in09 15.7333     # M10:  150 RPM
setp mux16.gear-factor.in10 20.0000     # M11:  118 RPM
setp mux16.gear-factor.in11 24.8421     # M12:   95 RPM
setp mux16.gear-factor.in12 26.2222     # M13:   90 RPM
setp mux16.gear-factor.in13 31.4667     # M14:   75 RPM
setp mux16.gear-factor.in14 39.3333     # M15:   60 RPM
setp mux16.gear-factor.in15 78.6667     # M16:   30 RPM

# Sinais gear-sel{0..3}: source vem do widget GearSelector da UI (postgui hal)
# Destinos: ambos os mux16 (clamp do cmd e ratio do PWM)
net gear-sel0 => mux16.spindle-cmd.sel0
net gear-sel0 => mux16.gear-factor.sel0
net gear-sel1 => mux16.spindle-cmd.sel1
net gear-sel1 => mux16.gear-factor.sel1
net gear-sel2 => mux16.spindle-cmd.sel2
net gear-sel2 => mux16.gear-factor.sel2
net gear-sel3 => mux16.spindle-cmd.sel3
net gear-sel3 => mux16.gear-factor.sel3

# Caminho do comando: cmd_chuck -> limit2.gNN (clampa por marcha) -> mux16 -> pid.s.command
net spindle-vel-cmd-rpm => limit2.g01.in
net spindle-vel-cmd-rpm => limit2.g02.in
net spindle-vel-cmd-rpm => limit2.g03.in
net spindle-vel-cmd-rpm => limit2.g04.in
net spindle-vel-cmd-rpm => limit2.g05.in
net spindle-vel-cmd-rpm => limit2.g06.in
net spindle-vel-cmd-rpm => limit2.g07.in
net spindle-vel-cmd-rpm => limit2.g08.in
net spindle-vel-cmd-rpm => limit2.g09.in
net spindle-vel-cmd-rpm => limit2.g10.in
net spindle-vel-cmd-rpm => limit2.g11.in
net spindle-vel-cmd-rpm => limit2.g12.in
net spindle-vel-cmd-rpm => limit2.g13.in
net spindle-vel-cmd-rpm => limit2.g14.in
net spindle-vel-cmd-rpm => limit2.g15.in
net spindle-vel-cmd-rpm => limit2.g16.in
net spindle-cmd-g01 <= limit2.g01.out => mux16.spindle-cmd.in00
net spindle-cmd-g02 <= limit2.g02.out => mux16.spindle-cmd.in01
net spindle-cmd-g03 <= limit2.g03.out => mux16.spindle-cmd.in02
net spindle-cmd-g04 <= limit2.g04.out => mux16.spindle-cmd.in03
net spindle-cmd-g05 <= limit2.g05.out => mux16.spindle-cmd.in04
net spindle-cmd-g06 <= limit2.g06.out => mux16.spindle-cmd.in05
net spindle-cmd-g07 <= limit2.g07.out => mux16.spindle-cmd.in06
net spindle-cmd-g08 <= limit2.g08.out => mux16.spindle-cmd.in07
net spindle-cmd-g09 <= limit2.g09.out => mux16.spindle-cmd.in08
net spindle-cmd-g10 <= limit2.g10.out => mux16.spindle-cmd.in09
net spindle-cmd-g11 <= limit2.g11.out => mux16.spindle-cmd.in10
net spindle-cmd-g12 <= limit2.g12.out => mux16.spindle-cmd.in11
net spindle-cmd-g13 <= limit2.g13.out => mux16.spindle-cmd.in12
net spindle-cmd-g14 <= limit2.g14.out => mux16.spindle-cmd.in13
net spindle-cmd-g15 <= limit2.g15.out => mux16.spindle-cmd.in14
net spindle-cmd-g16 <= limit2.g16.out => mux16.spindle-cmd.in15
net spindle-cmd-clamped <= mux16.spindle-cmd.out-f => pid.s.command

#*******************************************
#  CONEXOES FISICAS - GPIOs Mesa 7i92
#  (Referencia: mesa（部分配置可参考）.hal)
#*******************************************

# --- Spindle PWM output ---
setp hm2_7i92.0.pwmgen.00.output-type 1
setp hm2_7i92.0.pwmgen.00.scale 4980
# Linearizacao do VFD 9600: medido actual = 0.579*cmd + 51.3
# Inverso: pwmgen.value = (cmd - 51.3) / 0.579 = 1.727*cmd - 88.6
# Caixa de marchas: spindle-output (chuck RPM) -> mult2 (x ratio) -> scale.spindle-pwm (linearizacao motor)
setp scale.spindle-pwm.gain 1.727
setp scale.spindle-pwm.offset -88.6
net spindle-output       => mult2.spindle-gear.in0
net spindle-gear-factor  <= mux16.gear-factor.out-f      => mult2.spindle-gear.in1
net spindle-output-motor <= mult2.spindle-gear.out       => scale.spindle-pwm.in
net spindle-output-pwm   <= scale.spindle-pwm.out        => hm2_7i92.0.pwmgen.00.value
net spindle-enable => hm2_7i92.0.pwmgen.00.enable

# --- VFD 9600 two-line mode 1: X1=FWD, X2=REV (mutuamente exclusivos) ---
# Firmware novo: PWM1/PWM2 nao funcionam como saida digital. Usa GPIO direto.
# GPIO 001 (P2-14) -> Rele 1 NA -> X1 do VFD = FWD (M3)
# GPIO 003 (P2-15) -> Rele 2 NA -> X2 do VFD = REV (M4)
setp hm2_7i92.0.gpio.001.is_output 1
setp hm2_7i92.0.gpio.003.is_output 1
net spindle-cw  => hm2_7i92.0.gpio.001.out
net spindle-ccw => hm2_7i92.0.gpio.003.out

# --- Coolant flood output (TODO: mover para outra saida) ---
# net coolant-flood =>

#******************************
# connect miscellaneous signals
#******************************

#  ---HALUI signals---

net axis-select-x  halui.axis.x.select
net jog-x-pos      halui.axis.x.plus
net jog-x-neg      halui.axis.x.minus
net jog-x-analog   halui.axis.x.analog
net x-is-homed     halui.joint.0.is-homed
net axis-select-z  halui.axis.z.select
net jog-z-pos      halui.axis.z.plus
net jog-z-neg      halui.axis.z.minus
net jog-z-analog   halui.axis.z.analog
net z-is-homed     halui.joint.1.is-homed
net jog-selected-pos      halui.axis.selected.plus
net jog-selected-neg      halui.axis.selected.minus
net spindle-manual-cw     halui.spindle.0.forward
net spindle-manual-ccw    halui.spindle.0.reverse
net spindle-manual-stop   halui.spindle.0.stop
net machine-is-on         halui.machine.is-on
net jog-speed             halui.axis.jog-speed
net MDI-mode              halui.mode.is-mdi

#  ---coolant signals---

net coolant-mist      <=  iocontrol.0.coolant-mist
net coolant-flood     <=  iocontrol.0.coolant-flood

# feed override - sera configurado via mb2hal (PLC AMS32ES2)
# por enquanto desabilitado ate integrar o PLC
    setp halui.feed-override.direct-value false
    setp halui.feed-override.scale 0.01

#  ---motion control signals---

net in-position               <=  motion.in-position
net machine-is-enabled        <=  motion.motion-enabled

#  ---digital in / out signals---

#  ---estop signals---
# Configurado no custom.hal (and2.estop precisa ser carregado primeiro)

#  ---tool change signals (loopback direto - torno com torre que sempre completa)---
net tool-change-loop    iocontrol.0.tool-change   iocontrol.0.tool-changed
net tool-prepare-loop   iocontrol.0.tool-prepare  iocontrol.0.tool-prepared

