/* ==========================================================================
   Tema Fanuc/industrial - CyberDino v2
   Grafite neutro flat + semantica IEC (verde=iniciar, vermelho=parar,
   ambar=hold/funcao ativa) + acento ciano p/ selecao + DRO verde-sobre-preto.
   Paleta:
     fundo janela  #242729   paineis  #2E3234   borda painel #4A5055
     botao corpo   #3A3F43   hover    #474D52   borda botao  #141617
     acento ciano  #00838F   (hover-checked #0097A7, foco input #00ACC1)
     verde START   #1B9E3E   (pressed #23C24E)
     vermelho STOP #C62828   (pressed #E53935)
     ambar HOLD    #FFB300   (texto preto)
     DRO           fundo #0D0F0E, digitos #00E676, borda #3A3F43
   ========================================================================== */

QMainWindow {
    background: #242729
}

QsciScintilla {
    qproperty-backgroundcolor: #D9DADB;
    qproperty-marginbackgroundcolor: #D9DADB;
}

QStatusBar {
	color: white;
	font-family: "Bebas Kai";
    font-size: 12pt;
}

QPushButton, VCPSettingsPushButton, SubCallButton, QComboBox[editable="false"],
QComboBox[editable="true"]::drop-down {
    color: white;
    border-color: #141617;
    border-style: solid;
    border-radius: 5px;
    border-width: 2px;
    background: #3A3F43;
}

QComboBox QAbstractItemView {
    background: #2E3234;
    border: 2px solid #141617;
}

QPushButton {
    font-family: "Bebas Kai";
    font-size: 15pt;
}

QPushButton:disabled {
    border-color: #2A2D2F;
    color: rgb(200, 205, 208);
}

QPushButton:hover {
    background: #474D52;
}

QPushButton:pressed {
    background: #00838F;
}

QPushButton:checked[option="true"] {
    background: #00838F;
}

QPushButton:checked {
    background: #00838F;
}

/* ---- Semantica IEC ------------------------------------------------------ */

/* LIGAR (power): verde quando ligado */
QPushButton[actionName="machine.power.toggle"]:checked {
    background: #1B9E3E;
    color: white;
}

QPushButton[actionName="machine.power.toggle"]:pressed {
    background: #23C24E;
}

/* INICIAR (cycle start): verde sempre */
SafeCycleStart {
    background: #1B9E3E;
    color: white;
}

SafeCycleStart:hover {
    background: #23A94C;
}

SafeCycleStart:pressed {
    background: #23C24E;
}

/* PARAR (program.abort): vermelho */
QPushButton[actionName="program.abort"] {
    background: #C62828;
    color: white;
}

QPushButton[actionName="program.abort"]:hover {
    background: #D43535;
}

QPushButton[actionName="program.abort"]:pressed {
    background: #E53935;
}

/* FEED HOLD: ambar quando ativo (texto preto p/ contraste) */
QPushButton#feed_hold_button:checked {
    background: #FFB300;
    color: black;
}

/* E-STOP: base com borda vermelha (o estado acionado ja vem da rule no .ui) */
QPushButton#exit_button {
    border-color: #C62828;
}

/* CYCLE START rodando (acao indisponivel -> disabled): texto PRETO e o
   fundo PULSA entre verde claro/escuro via property 'pulse' alternada por
   timer no customs.py (_wire_cycle_start_pulse). */
SafeCycleStart:disabled {
    background: #2C7A44;
    color: black;
}

SafeCycleStart:disabled[pulse="on"] {
    background: #2FBF5A;
    color: black;
}

SafeCycleStart:disabled[pulse="off"] {
    background: #1B6E37;
    color: black;
}

QPushButton[actionName="program.abort"]:disabled {
    background: #8E2F2F;
    color: rgb(230, 210, 210);
}

/* ------------------------------------------------------------------------- */

VCPLineEdit,
QLineEdit {
    border-style: transparent;
    border-color: rgb(134, 136, 138);
    border-width: 2px;
    border-radius: 5px;
    color: black;
    background: white;
    selection-color: white;
    selection-background-color: #00838F;
    font: 15pt "Bebas Kai";
    padding-right: 2px;
}

QLineEdit:focus {
    border-style: solid;
    border-width: 3px;
    border-color: #00ACC1;
}

.QFrame {
    background-color: #2E3234;
    border-style: solid;
    border-color: #4A5055;
    border-width: 1px;
    border-radius: 6px;
}

DROWidget {
    color: #00E676;
    border-color: #3A3F43;
    border-style: solid;
    border-width: 1px;
    border-radius: 4px;
    background-color: #0D0F0E;
}

QGroupBox {
    border: 1px solid #4A5055;
    border-radius: 5px;
    margin-top: 1ex;
    font-size: 16pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 3px;
    color: white;
}

GcodeBackplot {
    border-color: #141617;
    border-style: solid;
    border-width: 2px;
    border-radius: 4px;
    background-color: black;
    margin: 10px;
    font: 12pt "Bebas Kai";
}

GcodeEditor {
    background-color: #2E3234;
    border-color: #141617;
    border-style: solid;
    border-width: 2px;
    border-radius: 4px;
    padding: 2px;
    font: 12pt "Bebas Kai";
}

GcodeTextEdit {
    background-color: #000000;
    color: #FFFFFF;
}

QScrollArea {
    border: none;
}

QScrollBar {
    background: #2E3234;
}

QScrollBar:horizontal {
    height: 20px;
}

QScrollBar:vertical {
    width: 20px;
}

QScrollBar::handle {
    background: #4A5055;
    border: 2px solid #2E3234;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    height: 20px;
    min-width: 25px;
}

QScrollBar::handle:vertical {
    width: 20px;
    min-height: 25px;
}

QScrollBar::add-line:horizontal {
    border: 4px solid #2E3234;
    background: #2E3234;
}

QScrollBar::sub-line:horizontal {
    border: 4px solid #2E3234;
    background: #2E3234;
}

QScrollBar::add-line:vertical {
    border: 4px solid #2E3234;
    background: #2E3234;
}

QScrollBar::sub-line:vertical {
    border: 4px solid #2E3234;
    background: #2E3234;
}

/*===========================================================================*/
/*                            Tabbed Widget                                  */
/*===========================================================================*/

QTabWidget {
    background: #2E3234;
}

QTabWidget::pane {
    background: transparent;
}

QTabWidget::tab-bar {
    left: 5px; /* move to the right by 5px */
}

QTabBar::tab {
    margin-top: 2px;
    margin-bottom: 2px;
    color: white;
    background: #33383B;
    border-style: solid;
    border-color: #141617;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-right-width: 1px;
    border-left-width: 1px;
    min-width: 10ex;
    min-height: 3ex;
    padding: 2px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: #3E4448;
}

QTabBar::tab:selected {
    background: #00838F;
}

QTabBar::tab:first {
    border-left-width: 2px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QTabBar::tab:last {
    border-right-width: 2px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QTabBar::tab:only-one {
    border-width: 2px;
    border-radius: 4px;
}


QWidget#buttonBox QPushButton {
    border-radius: 0px;
    border-left-width: 1px;
    border-right-width: 1px;
}

QWidget#buttonBox QPushButton[position='first'] {
    border-left-width: 2px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

QWidget#buttonBox QPushButton[position='last'] {
    border-right-width: 2px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

/***** Jog Increment Widget *****/
JogIncrementWidget {
    margin: 0px;
}

/*===========================================================================*/
/*                             QMenuBar                                      */
/*===========================================================================*/

QMenuBar {
    background-color: #2E3234;
    padding: 1px;
    border: 0px solid black;
    color: white;
    font-family: "Bebas Kai";
    font-size: 12pt;
}

QMenuBar:focus {
    border: 1px solid #00ACC1;
}

QMenuBar::item {
    background: transparent;
    padding: 3px;
}

QMenuBar::item:selected {
    padding: 3px;
    background: #474D52;
    border: 0px solid #454545;
}

QMenuBar::item:pressed {
    padding: 3px;
    border: 0px solid #454545;
    background-color: #00838F;
    color: #F0F0F0;
    margin-bottom: 0px;
    padding-bottom: 0px;
}

QMessageBox {
    color: white;
    background-color: #2E3234;
}

QMessageBox QLabel {
    font: 14pt "Bebas Kai";
    color: white;
}

QMessageBox QLabel[text] {
    padding-left: 0px;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 5px;
    margin: 0px;
}

QMessageBox QPushButton {
    min-height: 40px;
    max-height: 40px;
    font: 14pt "Bebas Kai";
    padding-left: 20px;
    padding-right: 20px;
    margin-top: 10px;
}

QDialog {
    background-color: #2E3234;
}

QDialog QLabel {
    font: 13pt "Bebas Kai";
    color: white;
}

/*===========================================================================*/
/*                               QMenu                                       */
/*===========================================================================*/

QMenu {
    border: 0px solid #454545;
    background-color: #3A3F43;
    color: white;
    margin: 0px;
    font-family: "Bebas Kai";
    font-size: 11pt;
}

QMenu::separator {
    height: 2px;
    background-color: #4A5055;
    color: red;
    padding-left: 4px;
    margin-left: 2px;
    margin-right: 2px;
}

QMenu::icon {
    margin: 0px;
    padding-left:4px;
}

QMenu::item {
    padding: 4px 24px 4px 24px;
    border: 1px transparent #454545;  /* reserve space for selection border */
}

QMenu::item:selected {
    background: #00838F;
    border: 0px solid #454545;
}

QMenu::indicator {
    width: 12px;
    height: 12px;
    padding-left:6px;
}

/*===========================================================================*/
/*                             tool and offset table                         */
/*===========================================================================*/

QHeaderView {
    font: 14pt "Bebas Kai";
    background-color: #3A3F43;
    color: white;
    border: none;
}

ToolTable, OffsetTable {
    border-top: 8px #2E3234;
    border-left: 4px #2E3234;
    border-bottom: 5px #2E3234;
    border-right: 4px #2E3234;
    border-radius: 5px;
    border-color: #2E3234;
    border-style: solid;
    background-color: #2E3234;
    gridline-color: #1F2224;
    alternate-background-color: #34393C;
    color: white;
    font: 15pt "Bebas Kai";
    selection-background-color: #00838F;
    selection-color: white;
}

QToolTip {
    background-color: #2E3234;
    color: white;
    border: 2px solid #4A5055;
    font: 15pt "Bebas Kai";
    padding: 5px;
    }

/* QFileDialog styling for Save As dialog */
QFileDialog {
    border: none;
}

QFileDialog QLabel {
    font: 15pt "Bebas Kai";
    padding-left: 8px;
}

QFileDialog QComboBox {
    color: white;
    font: 13pt "Bebas Kai";
    margin: 8px;
    min-height: 40px;
    max-height: 40px;
    min-width: 200px;
    icon-size: 16px 16px;
    /* Override global styles to prevent bleed-through */
    border-color: #141617;
    border-style: solid;
    border-radius: 5px;
    border-width: 2px;
    background: #3A3F43;
    padding: 0px;
    padding-right: 40px; /* Make room for drop-down button */
    padding-left: 10px;
}

QFileDialog QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 40px;
    border: none;
    border-left: 2px solid #141617;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    background: #3A3F43;
}

QFileDialog QComboBox::drop-down:hover {
    background: #474D52;
}

QFileDialog QComboBox::down-arrow {
    image: url(images/down_arrow.png);
    width: 16px;
    height: 16px;
}

QFileDialog QLineEdit {
    padding-left: 10px;
    margin: 8px;
    min-height: 40px;
    max-height: 40px;
    font: 12pt "sans";
}

QFileDialog QToolButton {
    icon-size: 28px 28px;
    min-width: 40px;
    min-height: 40px;
    background: transparent;
    border: none;
    margin: 8px;
}

QFileDialog QToolButton:hover {
    background: #474D52;
    border: 0px solid transparent;
    border-radius: 5px;
}

QFileDialog QToolButton:pressed {
    background: #00838F;
    border: 0px solid transparent;
    border-radius: 5px;
}

QFileDialog QPushButton,
QFileDialog QDialogButtonBox QPushButton,
QFileDialog QDialogButtonBox * QPushButton,
QFileDialog QWidget#buttonBox QPushButton {
    color: white !important;
    font-family: "Bebas Kai" !important;
    font-size: 15pt !important;
    background: #3A3F43 !important;
    border: 2px solid #141617 !important;
    border-radius: 5px !important;
    margin: 8px !important;
    padding: 0px 10px !important;
    min-height: 40px !important;
    min-width: 100px !important;
    max-height: 40px !important;
}

QFileDialog QDialogButtonBox {
    border: none !important;
    border-radius: 0px !important;
    background: transparent !important;
}

QFileDialog QPushButton:hover,
QFileDialog QDialogButtonBox QPushButton:hover,
QFileDialog QDialogButtonBox * QPushButton:hover,
QFileDialog QWidget#buttonBox QPushButton:hover {
    background: #474D52 !important;
}

QFileDialog QPushButton:pressed,
QFileDialog QDialogButtonBox QPushButton:pressed,
QFileDialog QDialogButtonBox * QPushButton:pressed,
QFileDialog QWidget#buttonBox QPushButton:pressed {
    background: #00838F !important;
}

QFileDialog QSplitter::handle {
    width: 8px;
    background: #242729;
}

QFileDialog QSplitter {
    margin: 10px;
    border: 1px solid #4A5055 !important;
}

QFileDialog QTreeView::item,
QFileDialog QListView::item,
QFileDialog QTableView::item {
    border: none !important;
    outline: none;
}

/* Sidebar (directory tree) specific item styling */
QFileDialog QTreeView#sidebar::item {
    padding: 4px 8px 4px 8px;
    border: none !important;
}

QFileDialog QTreeView#sidebar::item:selected {
    background: #00838F;
    color: white;
}

QFileDialog QTreeView#sidebar::item:hover {
    background: #474D52;
    color: white;
}

QFileDialog QTreeView::item:selected,
QFileDialog QListView::item:selected,
QFileDialog QTableView::item:selected {
    background: #00838F;
    color: white;
}

QFileDialog QTreeView::item:hover,
QFileDialog QListView::item:hover,
QFileDialog QTableView::item:hover {
    background: #474D52;
    color: white;
}

QFileDialog QAbstractScrollArea,
QFileDialog QAbstractScrollArea QWidget {
    border: none !important;
}

QFileDialog QFrame,
QFileDialog QWidget {
    border: none !important;
}

QFileDialog QHeaderView,
QFileDialog QHeaderView::section {
    border: none !important;
}

QFileDialog .QFrame {
    border: none !important;
    border-width: 0px !important;
}

/* Header styling - consistent with FileSystemTable */
QFileDialog QHeaderView {
    background-color: #3A3F43;
    color: white;
    border: none;
    border-radius: none;
    font: 13pt "Bebas Kai";
}

QFileDialog QHeaderView::section {
    background-color: #3A3F43;
    color: white;
    border: none;
    border-right: 1px solid #4A5055;
    border-bottom: 1px solid #4A5055;
    padding: 4px;
    font: 13pt "Bebas Kai";
}
